# Coptic Dictionary (.gitignore)
# Regenerate deps with: npm install

# dependencies
node_modules/

# Expo build output
.expo/
dist/
web-build/
static-build/
expo-env.d.ts

# Native (generated by: npx expo prebuild)
ios/
android/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.pfx
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug & JVM/Android crash logs (large)
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# OS / misc
.DS_Store
*.pem

# local env files
.env*.local
.env

# Firebase service config (local-only; contains a Google API key)
google-services.json

# User-confirmed public inclusion: only these three Android/Firebase files
!google-services.json
!android/
android/*
!android/app/
android/app/*
!android/app/google-services.json
!android/app/debug.keystore

# typescript / build cache
*.tsbuildinfo
.vercel

# editor / IDE
.idea/
.replit-artifact/
.vscode/
.manus/

# temp & scratch working dirs (large)
temp_bible/
temp_coptic/
temp_extracted/
scratch/
bible_pdfs/
fkpc_version/
.work/
outputs/

# Bible build junk  (KEEP: assets/bible/**/*.json + bibleAssets.ts)
assets/bible/*.pdf
assets/bible/*.zip
assets/bible/*.html
assets/bible/*.txt
# Generated full dictionary seed; runtime fetches it and stores it locally instead.
assets/dictionary.seed.json
assets/bible/scratch/
assets/bible/comparisons/

# one-off scratch files
get-pip.py
parsed_psalms_pdf.txt
/scratch_*.json
/scratch_*.txt
/build-error.txt
/device_config.txt
/device_ip.txt
/pid.txt
/tsc_err.txt
/tsc_out.txt
/_app_files.txt
/_tab_index.txt
/مهم
# Cloudflare notification admin key (never commit)
cloudflare/notifications-worker/.admin-api-token
cloudflare/notifications-worker/admin-api-token.txt
