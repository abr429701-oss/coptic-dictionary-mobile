  {
    "chapter": 4,
    "verse": 8,
    "text": "Ⲟⲩⲟϩ ⲁϥϣⲱⲡⲓ ̀ⲛϫⲉ ⲟⲩⲉϩⲟⲟⲩ ⲁϥⲥⲓⲛⲓ ̀ⲛϫⲉ ⲉⲗⲓⲥⲥⲉⲟⲥ ⲉⲥⲱⲙⲁⲛ ⲟⲩⲟϩ ⲛⲉ ⲟⲩⲟⲛ ⲟⲩⲛⲓϣϯ ̀ⲛⲥϩⲓⲙⲓ ̀ⲙⲙⲁⲩ ⲡⲉ ⲟⲩⲟϩ ⲁⲥⲁⲙⲟⲛⲓ ̀ⲙⲙⲟϥ ̀ⲉⲟⲩⲱⲙ ̀ⲛⲟⲩⲱⲓⲕ ⲟⲩⲟϩ ⲁⲥϣⲱⲡⲓ ⲉⲧⲁϥⲱⲥⲕ ⲉϥⲛⲁ ̀ⲉϧⲟⲩⲛ ̀ⲉⲙⲁⲩ ⲟⲩⲟϩ ⲉϥⲛⲏⲟⲩ ⲉⲃⲟⲗ ⲁϥⲣⲓⲕⲓ ̀ⲉⲙⲁⲩ ̀ⲉⲟⲩⲱⲙ ⲟⲩⲱⲓⲕ"
  },
  {
    "chapter": 4,
    "verse": 9,
    "text": "Ⲟⲩⲟϩ ⲡⲉϫⲉ ϯⲥϩⲓⲙⲓ ̀ⲙⲡⲉⲥϩⲁⲓ ϫⲉ ⲓⲥ ⲁⲓⲉⲙⲓ ϫⲉ ⲟⲩⲣⲱⲙⲓ ̀ⲛⲧⲉ ⲫϯ ⲡⲉ ⲫⲁⲓ ⲉϥⲟⲩⲁⲃ ⲉϥⲛⲏⲟⲩ ϩⲁⲣⲟⲛ ⲉϥⲙⲏⲛ"
  },
  {
    "chapter": 4,
    "verse": 10,
    "text": "Ⲙⲁⲣⲉⲛⲑⲁⲙⲓⲟ ⲛⲁϥ ̀ⲛⲟⲩⲕⲟⲩϫⲓ ̀ⲙⲙⲁ ⲥⲁⲡϣⲱⲓ ⲟⲩⲟϩ ̀ⲛⲧⲉⲛⲭⲁ ⲟⲩϭⲗⲟϫ ⲛⲁϥ ̀ⲙⲙⲁⲩ ⲛⲉⲙ ⲟⲩⲧⲣⲁⲡⲉⲍⲁ ⲛⲉⲙ ⲟⲩⲧⲟⲧⲥ ⲛⲉⲙ ⲟⲩⲗⲩⲭⲛⲓⲁ ⲟⲩⲟϩ ⲉⲥ̀ⲉϣⲱⲡⲓ ⲁϥϣⲁⲛ̀ⲓ ̀ⲉϧⲟⲩⲛ ϩⲁⲣⲟⲛ ⲉϥ̀ⲉⲣⲓⲕⲓ ̀ⲉϧⲟⲩⲛ ̀ⲉⲙⲁⲩ"
  },
  {
    "chapter": 4,
    "verse": 11,
    "text": "Ⲟⲩⲟϩ ⲁϥϣⲱⲡⲓ ̀ⲛϫⲉ ⲟⲩⲉϩⲟⲟⲩ ⲟⲩⲟϩ ⲁϥϣⲉ ⲛⲁϥ ̀ⲉϧⲟⲩⲛ ̀ⲉⲙⲁⲩ ⲟⲩⲟϩ ⲁϥⲣⲓⲕⲓ ̀ⲉϧⲟⲩⲛ ̀ⲉⲡⲓⲙⲁ ⲉⲧⲉ ̀ⲙⲡϣⲱⲓ ⲟⲩⲟϩ ⲁϥⲉⲛⲕⲟⲧ ̀ⲙⲙⲁⲩ"
  },
  {
    "chapter": 4,
    "verse": 12,
    "text": "Ⲟⲩⲟϩ ⲡⲉϫⲁϥ ̀ⲛⲅⲓⲉⲍⲓ ⲡⲉϥⲁⲗⲟⲩ ϫⲉ ⲙⲟⲩϯ ⲛⲏⲓ ̀ⲉϯⲥⲱⲙⲁⲛⲓⲧⲏⲥ ⲟⲩⲟϩ ⲁϥⲙⲟⲩϯ ̀ⲉⲣⲟⲥ ⲟⲩⲟϩ ⲁⲥⲟϩⲓ ̀ⲉⲣⲁⲧⲥ ̀ⲙⲡⲉϥ̀ⲙⲑⲟ"
  },
  {
    "chapter": 4,
    "verse": 13,
    "text": "Ⲟⲩⲟϩ ⲡⲉϫⲁϥ ⲛⲁⲥ ϫⲉ ⲁⲣⲉⲥⲉⲙⲛⲓ ̀ⲙⲡⲁⲓⲛⲓϣϯ ̀ⲛϩⲱⲃ ⲛⲁⲛ ⲟⲩ ϫⲉ ⲡⲉⲧⲥϣⲉ ̀ⲛⲁⲓϥ ⲛⲉ ⲓⲥϫⲉ ⲟⲩⲟⲛⲧⲉ ⲟⲩⲥⲁϫⲓ ̀ⲙⲙⲁⲩ ϩⲁ ⲡⲟⲩⲣⲟ ⲓⲉ ϩⲁ ⲡⲓⲁⲣⲭⲱⲛ ̀ⲛⲧⲉ ϯϫⲟⲙ ̀ⲛⲑⲟⲥ ⲇⲉ ⲡⲉϫⲁⲥ ϫⲉ ̀ⲙⲙⲟⲛ ⲁⲓϣⲟⲡ ̀ⲁⲛⲟⲕ ϧⲉⲛ ⲑⲙⲏϯ ̀ⲙⲡⲁⲗⲁⲟⲥ"
  },
  {
    "chapter": 4,
    "verse": 14,
    "text": "Ⲟⲩⲟϩ ⲡⲉϫⲁϥ ̀ⲛⲅⲓⲉⲍⲓ ⲡⲉϥⲁⲗⲟⲩ ϫⲉ ⲟⲩ ⲡⲉⲧⲥϣⲉ ̀ⲛⲁⲓϥ ⲛⲁⲥ ⲟⲩⲟϩ ⲡⲉϫⲉ ⲅⲓⲉⲍⲓ ⲡⲉϥⲁⲗⲟⲩ ϫⲉ ⲕⲉ ⲙⲁⲗⲗⲟⲛ ̀ⲙⲙⲟⲛⲧⲉⲥ ϣⲏⲣⲓ ̀ⲙⲙⲁⲩ ⲟⲩⲟϩ ⲡⲉⲥϩⲁⲓ ⲁϥⲉⲣϧⲉⲗⲗⲟ"
  },
  {
    "chapter": 4,
    "verse": 15,
    "text": "Ⲟⲩⲟϩ ⲡⲉϫⲁϥ ϫⲉ ⲙⲟⲩϯ ̀ⲉⲣⲟⲥ ⲟⲩⲟϩ ⲁⲥⲟϩⲓ ̀ⲉⲣⲁⲧⲥ ϧⲁⲧⲉⲛ ⲡⲓⲣⲟ"
  },
  {
    "chapter": 4,
    "verse": 16,
    "text": "Ⲟⲩⲟϩ ⲡⲉϫⲉ ⲉⲗⲓⲥⲥⲉⲟⲥ ⲛⲁⲥ ϫⲉ ϧⲉⲛ ⲡⲁⲓⲥⲏⲟⲩ ̀ⲙⲫⲣⲏϯ ⲉⲧⲁⲓⲟⲩⲛⲟⲩ ⲉⲣⲉⲱⲛϧ ̀ⲛⲑⲟ ⲉⲣⲉⲉⲣⲃⲟⲕⲓ ̀ⲛⲟⲩϣⲏⲣⲓ ̀ⲛⲑⲟⲥ ⲇⲉ ⲡⲉϫⲁⲥ ϫⲉ ̀ⲙⲫⲱⲣ ⲡⲁ⳪̅ ̀ⲙⲡⲉⲣⲥⲱⲃⲓ ̀ⲛⲧⲉⲕⲃⲱⲕⲓ"
  },
  {
    "chapter": 4,
    "verse": 17,
    "text": "Ⲟⲩⲟϩ ⲁⲥⲉⲣⲃⲟⲕⲓ ̀ⲛϫⲉ ϯⲥϩⲓⲙⲓ ⲁⲥⲙⲓⲥⲓ ̀ⲛⲟⲩϣⲏⲣⲓ ϧⲉⲛ ⲡⲓⲥⲏⲟⲩ ̀ⲙⲫⲣⲏϯ ̀ⲛϯⲟⲩⲛⲟⲩ ⲉⲥⲟⲛϧ ⲕⲁⲧⲁ ⲫⲣⲏϯ ⲉⲧⲁϥⲥⲁϫⲓ ⲛⲉⲙⲁⲥ ̀ⲛϫⲉ ⲉⲗⲓⲥⲥⲉⲟⲥ"
  },
  {
    "chapter": 4,
    "verse": 18,
    "text": "Ⲟⲩⲟϩ ⲁϥⲉⲣⲛⲓϣϯ ̀ⲛϫⲉ ⲡⲓⲁⲗⲟⲩ ⲟⲩⲟϩ ⲁⲥϣⲱⲡⲓ ⲉⲧⲁϥ̀ⲓ ̀ⲉⲃⲟⲗ ̀ⲛϫⲉ ⲡⲓⲁⲗⲟⲩ ϣⲁ ⲡⲉϥⲓⲱⲧ ϩⲁ ⲛⲓϭⲁⲓⲱⲥϧ"
  },
  {
    "chapter": 4,
    "verse": 19,
    "text": "Ⲟⲩⲟϩ ⲡⲉϫⲁϥ ̀ⲙⲡⲉϥⲓⲱⲧ ϫⲉ ⲧⲁⲁⲫⲉ ⲟⲩⲟϩ ⲡⲉϫⲁϥ ̀ⲙⲡⲓⲁⲗⲟⲩ ϫⲉ ⲁⲗⲓⲧϥ ϭⲓⲧϥ ̀ⲛⲧⲉϥⲙⲁⲩ"
  },
  {
    "chapter": 4,
    "verse": 20,
    "text": "... ⲟⲩⲟϩ ⲁϥⲉⲛⲕⲟⲧ ̀ⲉϫⲉⲛ ⲛⲉⲥⲁⲗⲱϫ ϣⲁ ⲫⲛⲁⲩ ̀ⲙⲙⲉⲣⲓ ⲟⲩⲟϩ ⲁϥⲙⲟⲩ"
  },
  {
    "chapter": 4,
    "verse": 21,
    "text": "Ⲟⲩⲟϩ ⲁⲥⲟⲗϥ ̀ⲉⲡϣⲱⲓ ⲁⲥϣⲧⲟϥ ϩⲓϫⲉⲛ ⲡⲓⲙⲁ̀ⲛⲉⲛⲕⲟⲧ ̀ⲙⲡⲓⲣⲱⲙⲓ ̀ⲛⲧⲉ ⲫϯ ⲁⲥϣⲑⲁⲙ ⲉⲣⲟϥ ⲟⲩⲟϩ ⲁⲥ̀ⲓ ̀ⲉⲃⲟⲗ"
  },
  {
    "chapter": 4,
    "verse": 22,
    "text": "Ⲁⲥⲙⲟⲩϯ ̀ⲉⲡⲉⲥϩⲁⲓ ⲡⲉϫⲁⲥ ⲛⲁϥ ϫⲉ ⲟⲩⲉⲣⲡ ⲟⲩⲁⲓ ̀ⲛⲛⲓⲁⲗⲱⲟⲩⲓ ⲛⲉⲙⲏⲓ ⲛⲉⲙ ⲟⲩⲓ ϧⲉⲛ ⲛⲓⲉⲱ ̀ⲛⲧⲁϣⲉ ⲛⲏⲓ ϣⲁ ⲛⲓⲣⲱⲙⲓ ̀ⲛⲧⲉ ⲫϯ ⲟⲩⲟϩ ̀ⲛⲧⲁⲧⲁⲥⲑⲟ"
  },
  {
    "chapter": 4,
    "verse": 23,
    "text": "Ⲟⲩⲟϩ ⲡⲉϫⲁϥ ϫⲉ ⲡⲓϩⲱⲃ ⲟⲩ ⲡⲉ ϫⲉ ⲧⲉⲣⲁϣⲉ ⲛⲉ ϩⲁⲣⲟϥ ̀ⲙⲫⲟⲟⲩ ⲟⲩⲇⲉ ⲥⲟⲩⲁⲓ ⲁⲛ ⲡⲉ ... ̀ⲛⲑⲟⲥ ⲇⲉ ⲡⲉϫⲁⲥ ϫⲉ ⲧϩⲓⲣⲏⲛⲏ"
  },
  {
    "chapter": 4,
    "verse": 24,
    "text": "Ⲟⲩⲟϩ ⲁⲥϧⲱⲕ ̀ⲛϯⲉⲱ ⲟⲩⲟϩ ⲡⲉϫⲁⲥ ̀ⲙⲡⲓⲁⲗⲟⲩ ϫⲉ ⲙⲁϣⲉ ⲛⲁⲕ ̀ⲙⲡⲉⲣⲧⲁϩⲛⲟ ̀ⲙⲙⲟⲓ ̀ⲉⲁⲗⲏⲓ ϫⲉ ⲁⲓϣⲁⲛϫⲟⲥ ⲛⲁⲕ"
  },
  {
    "chapter": 4,
    "verse": 25,
    "text": "Ϫⲉ ⲁⲙⲟⲩ ⲉⲕ̀ⲉⲙⲟϣⲓ ⲟⲩⲟϩ ⲉⲕ̀ⲉ̀ⲓ ϩⲁ ⲡⲓⲣⲱⲙⲓ ̀ⲛⲧⲉ ⲫϯ Go, and thou shalt proceed, and come to the man of God to mount Carmel."
  },
