  {
    "chapter": 1,
    "verse": 14,
    "text": "ⲟⲩϣⲁⲗ ⲛⲉⲙ ⲟⲩⲁⲗⲗⲱⲓ ⲛⲉⲙ ̀ⲛϩⲏⲛⲓ ⲧⲏⲣⲟⲩ ⲉⲧⲥⲱⲧⲡ"
  },
  {
    "chapter": 1,
    "verse": 15,
    "text": "ⲉⲩⲟⲓ ̀ⲛⲑⲏ ̀ⲛⲟⲩⲡⲓⲅⲏ ̀ⲛⲕⲁⲣⲡⲟⲥ ⲟⲩⲟϩ ⲟⲩϣⲱϯ ̀ⲙⲙⲱⲟⲩ ⲉϥϣⲟⲩⲟ ̀ⲉⲃⲟⲗ ϧⲉⲛ ⲡⲓⲗⲓⲃⲁⲛⲟⲥ"
  },
  {
    "chapter": 1,
    "verse": 16,
    "text": "ⲧⲱⲟⲩⲛ ⲡⲉⲙϩⲓⲧ ⲁⲙⲟⲩ ̀ⲉⲡⲧⲟⲩⲣⲏⲥ ⲛⲉⲅⲛⲓϥⲓ ̀ⲉϧⲟⲩⲛ ϧⲉⲛ ⲡⲁⲓⲕⲩⲡⲟⲥ ⲛⲧⲉ ⲛⲁϩⲏⲛⲉ ϯ ̀ⲛⲛⲉⲩⲥⲧⲟⲓ"
  },
  {
    "chapter": 1,
    "verse": 17,
    "text": "-"
  },
  {
    "chapter": 2,
    "verse": 1,
    "text": "ⲙⲁⲣⲉ ⲡⲁⲥⲟⲛ ⲃⲱⲕ ̀ⲉϩⲣⲏⲓ ̀ⲉⲡⲉϥⲕⲩⲡⲟⲥ ⲛⲉϥⲟⲩⲱⲙ ⲛⲉⲙ ⲕⲁⲣⲡⲟⲥ ⲛⲉⲛϣⲏⲛ ⲁⲓⲃⲱⲕ ̀ⲉϧⲟⲩⲛ ̀ⲉⲡⲁⲩⲕⲩⲡⲟⲥ ⲧⲁⲥⲱⲛⲓ ⲧⲁϣⲉⲗⲉⲧ ⲧⲁϫⲱⲗⲓ ̀ⲙⲡⲁϣⲁⲗ ⲛⲉⲙ ⲡⲁϣⲟⲩϩⲏⲛⲓ ⲁⲓⲟⲩⲱⲙ ⲙ̀ⲡⲁⲱⲓⲕ ⲛⲉⲙ ⲡⲁⲉⲃⲓⲱ ⲁⲓⲥⲱ ̀ⲙⲡⲁⲏⲣⲡ ⲛⲉⲙ ⲡⲁⲉⲣⲱϯ ⲟⲩⲱⲙ ϩⲱⲧ ⲧⲏⲟⲩⲧⲉⲛ ⲛⲁϣⲫⲏⲣ ̀ⲛⲧⲉⲧⲉⲛⲥⲓ ̀ⲛⲧⲉⲧⲉⲛϯϩⲉ ⲛⲁⲥⲛⲏⲟⲩ"
  },
  {
    "chapter": 2,
    "verse": 2,
    "text": "̀ⲁⲛⲟⲕ ϯⲱⲃϣ ⲟⲩⲟϩ ⲡⲁϩⲏⲧ ⲣⲏⲥ ⲓⲥ ⲡⲉϧⲣⲱⲟⲩ ̀ⲙⲡⲁⲥⲟⲛ ⲉϥⲧⲱϩⲉⲙ ̀ⲉⲫⲣⲟ ϫⲉ ⲁⲟⲩⲱⲛ ⲛⲁⲛ ⲧⲁⲥⲱⲛⲓ ⲧⲁϣⲉⲗⲏⲧ ⲧⲁϫⲟⲙ ⲡⲉ ⲉⲧϫⲏⲕ ⲉⲃⲟⲗ ϫⲉ ⲉⲧⲁ ⲁⲫⲉ ⲙⲟⲩϩ ⲛⲓⲱϯ ⲟⲩⲟϩ ⲁ ⲡⲁⲃⲱ ⲧⲟⲗⲉⲙ ⲁϥⲙⲟⲩϩ ̀ⲛϫⲁϥ"
  },
  {
    "chapter": 2,
    "verse": 3,
    "text": "ⲁⲓⲕⲁⲧⲕⲁϩⲏⲟⲩ ̀ⲛⲧⲁϣⲧⲉⲛ ̀ⲛϫⲱⲣϩ ⲉⲓⲛⲁⲧⲁⲁⲥ ϩⲓⲱⲧⲱⲛ ̀ⲛⲁϣ ̀ⲛϩⲉ ⲁⲓⲉⲓⲱ ⲛⲁⲟⲩⲁⲣⲉⲧⲏ ⲉⲓⲛⲁⲧⲟⲗⲙⲟⲩ ⲟⲛ ̀ⲛⲁϣ ̀ⲛϩⲉ"
  },
  {
    "chapter": 2,
    "verse": 4,
    "text": "ⲡⲁⲥⲟⲛ ⲁϥϫⲉⲩ ̀ⲛⲧⲟⲧϥ ̀ⲉϧⲟⲩⲛ ϧⲉⲛ ⲡⲟⲩⲱϣ ̀ⲙⲡⲓⲣⲟ ⲟⲩⲟϩ ⲁ ⲡⲁϩⲏⲧ ϣⲑⲟⲣⲧⲉⲣ ̀ⲛⲥⲱϥ"
  },
  {
    "chapter": 2,
    "verse": 5,
    "text": "ⲁⲓⲧⲱⲟⲩⲛ ̀ⲁⲛⲟⲕ ⲉⲧⲣⲁⲟⲩⲱⲛ ̀ⲙⲡⲁⲥⲟⲛ ⲟⲩⲟϩ ⲁ ⲛⲁϫⲓϫ ⲧⲁⲩⲉ ϣⲁⲗ ̀ⲉⲡⲉⲥⲏⲧ ⲛⲁⲧⲏⲃⲓ ⲁⲩⲧⲁⲩⲉ ϣⲁⲗ ⲉϥⲥⲟⲧⲡ ̀ⲉⲃⲟⲗ"
  },
  {
    "chapter": 2,
    "verse": 6,
    "text": "ⲁⲓⲟⲩⲱⲛ ̀ⲙⲡⲁⲥⲟⲛ ⲟⲩⲟϩ ⲁϥⲥⲁⲁⲧ ⲁⲓⲕⲱϯ ̀ⲛⲥⲱϥ ⲟⲩⲟϩ ̀ⲙⲡⲓϩⲉ ̀ⲉⲣⲟϥ"
  },
  {
    "chapter": 2,
    "verse": 7,
    "text": "ⲁⲩϩⲉ ̀ⲉⲣⲟⲓ ̀ⲛϫⲉ ⲛⲉⲧⲣⲱⲓⲥ ϧⲉⲛ ⲧⲡⲟⲗⲓⲥ ⲁⲩⲕⲱϯ ̀ⲉⲣⲟⲥ ⲁⲩⲣⲁϧⲧ ⲁⲩⲡⲗⲁⲅⲏ ̀ⲙⲙⲟⲓ ⲁⲩϥⲓ ̀ⲙⲡⲁⲉⲣϣⲱⲛ ̀ⲛⲧⲟⲧ ̀ⲛϫⲉ ⲛⲉⲧⲣⲱⲓⲥ ̀ⲛⲥⲟⲃⲧ"
  },
  {
    "chapter": 2,
    "verse": 8,
    "text": "ⲁⲓⲧⲁⲣⲉⲕ ⲧⲏⲟⲩⲧⲉⲛ ̀ⲛϣⲉⲣⲓ ̀ⲛⲓⲉⲣⲟⲩⲥⲁⲗⲏⲙ ϧⲉⲛ ̀ⲛϫⲟⲙ ⲟⲩⲟϩ ϧⲉⲛ ̀ⲛⲛⲟⲙϯ ̀ⲛⲧⲥⲱϣⲓ ϫⲉ ⲁⲧⲉⲧⲉⲛϣⲁⲛϩⲉ ̀ⲉⲡⲁⲥⲟⲛ ⲟⲩ ⲡⲉ ⲧⲉⲧⲉⲛⲛⲁϫⲟϥ ⲛⲁϥ"
  },
  {
    "chapter": 2,
    "verse": 9,
    "text": "ⲙⲁⲧⲁⲙⲟⲛ ϫⲉ ⲟⲩ ⲁϣ ̀ⲙⲙⲓⲛ ⲡⲉ ⲡⲟⲩⲥⲟⲛ ⲱ ⲧⲉⲧⲉⲛⲓⲥⲱⲥ ϧⲉⲛ ⲛⲓϩⲓⲟⲙⲓ"
  },
  {
    "chapter": 2,
    "verse": 10,
    "text": "ⲡⲉⲥⲙⲟⲧ ̀ⲙⲡⲁⲥⲟⲛ ⲡⲉ ⲉϥ̀ⲉⲑⲣⲉϣⲣⲱϣ ⲁϥⲣⲉϩⲉ ⲧⲏⲣϥ ⲉⲣⲉ ⲛⲉϥϩⲟⲓϯ ⲟⲛⲓ ⲥⲑⲟⲓⲛⲟⲩϥⲓ ϧⲉⲛ ⲟⲩϣⲁⲗ ⲛⲉⲙ ⲟⲩⲗⲓⲃⲁⲛⲟⲥ ̀ⲉⲃⲟⲗ ϧⲉⲛ ̀ⲛϩⲏⲛⲓ ⲧⲏⲣⲟⲩ ̀ⲛⲣⲉϥⲡⲓⲉⲥⲱϫⲉⲛ"
  },
