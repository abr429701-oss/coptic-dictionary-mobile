  {
    "chapter": 1,
    "verse": 17,
    "text": "Ⲟⲩⲟϩ ⲁϥⲉⲣϩⲏⲃⲓ ̀ⲛϫⲉ ⲇⲁⲩⲓⲇ ̀ⲙⲡⲁⲓϩⲏⲃⲓ ̀ⲉϩⲣⲏⲓ ̀ⲉϫⲉⲛ ⲥⲁⲟⲩⲗ ⲛⲉⲙ ̀ⲉϫⲉⲛ ⲓⲱⲛⲁⲑⲁⲛ ⲡⲉϥϣⲏⲣⲓ"
  },
  {
    "chapter": 1,
    "verse": 18,
    "text": "Ⲟⲩⲟϩ ⲁϥϫⲟⲥ ⲉⲧⲥⲁⲃⲉ ⲛⲉⲛϣⲏⲣⲓ ̀ⲛⲓⲟⲩⲇⲁ ⲟⲩⲟϩ ⲡⲉϫⲁϥ"
  },
  {
    "chapter": 1,
    "verse": 19,
    "text": "Ⲁⲣⲓⲧϥ ̀ⲛⲟⲩⲥⲧⲩⲗⲏ ̀ⲙⲡⲓⲥ̅ⲗ̅ ̀ⲉϩⲣⲏⲓ ̀ⲉϫⲉⲛ ⲛⲏ ⲉⲧⲁⲩⲙⲟⲩ ̀ⲛⲛⲓϧⲱⲧⲉⲃ ⲉⲩ ϩⲓϫⲉⲛ ⲡⲉⲕⲙⲁ ⲉⲧϭⲟⲥⲓ ⲡⲱⲥ ⲁⲩϩⲉⲓ ̀ⲛϫⲉ ϩⲁⲛϫⲱⲣⲓ"
  },
  {
    "chapter": 1,
    "verse": 20,
    "text": "̀Ⲙⲡⲉⲣⲧⲁⲙⲉ ̀ⲛⲅⲉⲑ ⲟⲩⲇⲉ ̀ⲙⲡⲉⲣϩⲓϣⲉⲛⲛⲟⲩϥⲓ ϧⲉⲛ ⲛⲓⲙⲱⲓⲧ ̀ⲉⲃⲟⲗ ̀ⲛⲧⲉ ⲁⲥⲕⲁⲗⲱⲛ ⲙⲏⲡⲟⲧⲉ ̀ⲛⲧⲟⲩⲟⲩⲛⲟϥ ̀ⲙⲙⲱⲟⲩ ̀ⲛϫⲉ ⲛⲓϣϣⲉⲣⲓ ̀ⲛⲧⲉ ⲛⲓⲁⲗⲗⲟⲫⲩⲗⲟⲥ ⲙⲏⲡⲟⲧⲉ ̀ⲛⲧⲟⲩⲑⲉⲗⲏⲗ ̀ⲙⲙⲱⲟⲩ ̀ⲛϫⲉ ⲛⲓϣⲉⲣⲓ ̀ⲛⲧⲉ ⲛⲓⲁⲧⲥⲉⲃⲓ"
  },
  {
    "chapter": 1,
    "verse": 21,
    "text": "Ⲛⲓⲧⲱⲟⲩ ⲉⲧⲉ ⲅⲉⲗⲃⲟⲩⲉ ̀ⲙⲡⲉⲛⲑⲣⲉ ⲙⲟⲩⲛϩⲱⲟⲩ ⲟⲩⲇⲉ ⲓⲱϯ ⲓ ̀ⲉϫⲉⲛ ⲑⲏⲛⲟⲩ ⲛⲉⲙ ⲛⲓⲓⲟϩⲓ ̀ⲛⲧⲉ ⲛⲓⲁⲡⲁⲣⲭⲏ ϫⲉ ⲁⲥϩⲉⲓ ̀ⲙⲙⲁⲩ ⲛϫⲉ ⲧϣⲉⲃϣⲓ ̀ⲛⲧⲉ ⲛⲓϫⲱⲣⲓ ⲧϣⲉⲃϣⲓ ̀ⲛⲥⲁⲟⲩⲗ ̀ⲙⲡⲟⲩⲑⲁϩⲥ ̀ⲛⲛⲉϥ"
  },
  {
    "chapter": 1,
    "verse": 22,
    "text": "̀Ⲉⲃⲟⲗ ϩⲁ ⲡⲥⲛⲟϥ ̀ⲛⲧⲉ ⲛⲓϧⲱⲧⲉⲃ ⲛⲉⲙ ̀ⲉⲃⲟⲗ ϩⲁ ⲡⲓⲱⲧ ̀ⲛⲧⲉ ⲛⲓϫⲱⲣⲓ ̀ⲙⲫⲣⲏϯ ̀ⲛϯⲫⲓϯ ̀ⲛⲧⲉ ⲓⲱⲛⲁⲑⲁⲛ ̀ⲙⲡⲉⲥⲧⲁⲥⲑⲟ ̀ⲉⲫⲁϩⲟⲩ ⲉⲥϣⲟⲩⲓⲧ ⲟⲩⲟϩ ϯⲥⲏϥⲓ ̀ⲛⲧⲉ ⲥⲁⲟⲩⲗ ̀ⲙⲡⲉⲥⲧⲁⲥⲑⲟ ⲉⲥϣⲟⲩⲓⲧ"
  },
  {
    "chapter": 1,
    "verse": 23,
    "text": "Ⲥⲁⲟⲩⲗ ⲛⲉⲙ ⲓⲱⲛⲁⲑⲁⲛ ⲛⲓⲙⲉⲛⲣⲁϯ ⲟⲩⲟϩ ⲛⲓⲥⲁⲓⲱⲟⲩ ̀ⲙⲡⲟⲩϯⲟⲩⲱ ̀ⲉⲃⲟⲗ ̀ⲛϧⲣⲏⲓ ϧⲉⲛ ⲡⲟⲩⲱⲛϧ ⲟⲩⲟϩ ϧⲉⲛ ⲡⲟⲩⲕⲉⲙⲟⲩ ̀ⲙⲡⲟⲩϯⲟⲩⲱ ̀ⲉⲃⲟⲗ ⲥⲉⲥⲁⲓⲱⲟⲩ ⲉϩⲟⲧⲉ ⲛⲓⲁϧⲱⲙ ⲟⲩⲟϩ ⲁⲩϣⲱⲡⲓ ̀ⲉϫⲱⲣ ⲉϩⲟⲧⲉ ⲛⲓⲙⲟⲩⲓ"
  },
  {
    "chapter": 1,
    "verse": 24,
    "text": "Ⲛⲓϣⲉⲣⲓ ⲛⲧⲉ ⲡⲓⲥ̅ⲗ̅ ⲣⲓⲙⲓ ̀ⲉϫⲉⲛ ⲥⲁⲟⲩⲏⲗ ⲫⲏ ⲉⲧϯϩⲓⲱⲧ ⲑⲏⲛⲟⲩ ̀ⲛϩⲁⲛⲕⲟⲕⲕⲟⲥ ⲛⲉⲙ ⲡⲉⲧⲉⲛⲥⲟⲗⲥⲉⲗ ⲫⲏ ⲉⲧⲓⲛⲓ ̀ⲉϩⲣⲏⲓ ̀ⲛⲟⲩⲥⲟⲗⲥⲉⲗ ̀ⲛⲛⲟⲩⲃ ϩⲓϫⲉⲛ ⲛⲉⲧⲉⲛϩⲉⲃⲥⲱ"
  },
  {
    "chapter": 1,
    "verse": 25,
    "text": "Ⲡⲱⲥ ⲁⲩϩⲉⲓ ̀ⲛϫⲉ ϩⲁⲛϫⲱⲣⲓ ϧⲉⲛ ⲑⲙⲏϯ ̀ⲙⲡⲓⲡⲟⲗⲉⲙⲟⲥ ⲓⲱⲛⲁⲑⲁⲛ ⲁⲩⲙⲁϣⲕ ⲉⲩⲙⲟⲩ"
  },
  {
    "chapter": 1,
    "verse": 26,
    "text": "Ϯⲙⲟⲕϩ ̀ⲛϩⲏⲧ ϧⲁⲣⲟⲕ ⲡⲁⲥⲟⲛ ⲓⲱⲛⲁⲑⲁⲛ ⲁⲕϣⲱⲡⲓ ̀ⲉⲛⲁⲥⲱⲕ ̀ⲛⲧⲟⲧ ̀ⲉⲙⲁϣⲱ ⲁ ⲧⲉⲕⲁⲅⲁⲡⲏ ϣⲱⲡⲓ ⲛⲏⲓ ̀ⲉⲟⲩϣⲫⲏⲣⲓ ̀ⲉϩⲟⲧⲉ ⲧⲁⲅⲁⲡⲏ ̀ⲛϩⲁⲛϩⲓⲟⲙⲓ"
  },
  {
    "chapter": 1,
    "verse": 27,
    "text": "Ⲡⲱⲥ ⲁⲩϩⲉⲓ ̀ⲛϫⲉ ϩⲁⲛϫⲱⲣⲓ ⲟⲩⲟϩ ⲁⲩⲧⲁⲕⲟ ̀ⲛϫⲉ ϩⲁⲛⲥⲕⲉⲩⲟⲥ ̀ⲙⲡⲟⲗⲉⲙⲓⲕⲟⲛ"
  },
