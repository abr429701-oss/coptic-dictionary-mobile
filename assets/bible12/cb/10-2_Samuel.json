  {
    "chapter": 6,
    "verse": 1,
    "text": "Ⲟⲩⲟϩ ⲁ ⲇⲁⲩⲓⲇ ⲑⲱⲟⲩϯ ̀ⲛϧⲉⲗϣⲓⲣⲓ ⲛⲓⲃⲉⲛ ̀ⲛⲧⲉ ⲡⲓⲥ̅ⲗ̅ ⲉⲩⲉⲣϣⲃⲉ ̀ⲛϣⲟ"
  },
  {
    "chapter": 6,
    "verse": 2,
    "text": "Ⲟⲩⲟϩ ⲁϥⲧⲱⲛϥ ̀ⲛϫⲉ ⲇⲁⲩⲓⲇ ⲁϥϣⲉ ⲛⲁϥ ⲛⲉⲙ ⲡⲓⲗⲁⲟⲥ ⲧⲏⲣϥ ⲉⲑⲛⲉⲙⲁϥ ⲛⲉⲙ ̀ⲉⲃⲟⲗ ϧⲉⲛ ⲛⲓⲁⲣⲭⲱⲛ ̀ⲛⲧⲉ ⲓⲟⲩⲇⲁ ϩⲓ ⲡⲓⲙⲱⲓⲧ ̀ⲉⲡϣⲱⲓ ϫⲉ ̀ⲛⲧⲟⲩⲓⲛⲓ ̀ⲛϯⲕⲓⲃⲱⲧⲟⲥ ̀ⲛⲧⲉ ⲫϯ ̀ⲉⲡϣⲱⲓ ̀ⲉⲃⲟⲗ ̀ⲙⲙⲁⲩ ⲑⲏ ⲉⲧⲟⲩⲙⲟⲩϯ ̀ⲉϫⲱⲥ ̀ⲙⲫⲣⲁⲛ ̀ⲙⲡ⳪̅ ̀ⲛⲧⲉ ⲛⲓϫⲟⲙ ⲉϥϩⲉⲙⲥⲓ ϩⲓϫⲉⲛ ⲛⲓⲭⲉⲣⲟⲩⲃⲓⲙ ⲉⲧⲭⲏ ϩⲓϫⲱⲥ"
  },
  {
    "chapter": 6,
    "verse": 3,
    "text": "Ⲟⲩⲟϩ ⲁⲩⲧⲁⲗⲟ ̀ⲛϯⲕⲓⲃⲱⲧⲟⲥ ̀ⲛⲧⲉ ⲡ⳪̅ ̀ⲉⲟⲩⲙⲃⲣⲉϩⲓ ̀ⲙⲃⲉⲣⲓ ⲁⲩⲟⲗⲥ ̀ⲉⲃⲟⲗ ϧⲉⲛ ⲡⲏⲓ ̀ⲛⲁⲙⲓⲛⲁⲇⲁⲃ ⲫⲏ ⲉⲧⲭⲏ ϧⲉⲛ ϯⲕⲁⲗⲁⲙⲫⲟ ⲟⲩⲟϩ ⲟⲍⲁ ⲛⲉⲙ ⲛⲉϥⲥⲛⲏⲟⲩ ⲛⲉⲛϣⲏⲣⲓ ̀ⲛⲁⲙⲓⲛⲁⲇⲁⲃ ⲛⲁⲩⲓⲛⲓ ̀ⲙⲡⲓⲙⲃⲣⲉϩⲓ"
  },
  {
    "chapter": 6,
    "verse": 4,
    "text": "Ⲛⲉⲙ ϯⲕⲓⲃⲱⲧⲟⲥ ⲟⲩⲟϩ ⲛⲉϥⲥⲛⲏⲟⲩ ⲛⲁⲩⲙⲟϣⲓ ϧⲁϫⲱⲥ ̀ⲛϯⲕⲓⲃⲱⲧⲟⲥ"
  },
  {
    "chapter": 6,
    "verse": 5,
    "text": "Ⲟⲩⲟϩ ⲇⲁⲩⲓⲇ ⲛⲉⲙ ⲛⲉⲛϣⲏⲣⲓ ̀ⲙⲡⲓⲥ̅ⲗ̅ ⲛⲁⲩⲥⲱⲃⲓ ̀ⲙⲡⲉ̀ⲙⲑⲟ ̀ⲙⲡ⳪̅ ϧⲉⲛ ϩⲁⲛⲟⲣⲅⲁⲛⲟⲛ ⲉⲩϩⲱⲧⲡ ϧⲉⲛ ⲟⲩϫⲟⲙ ⲛⲉⲙ ϩⲁⲛϩⲱⲇⲏ ⲛⲉⲙ ϩⲁⲛⲕⲩⲑⲁⲣⲁ ⲛⲉⲙ ϩⲁⲛⲛⲁⲃⲗⲁ ⲛⲉⲙ ϩⲁⲛⲕⲉⲙⲕⲉⲙ ⲛⲉⲙ ϩⲁⲛⲕⲩⲙⲃⲁⲗⲟⲛ ⲛⲉⲙ ϩⲁⲛⲥⲏⲃⲓ ̀ⲛϫⲱ"
  },
  {
    "chapter": 6,
    "verse": 6,
    "text": "Ⲟⲩⲟϩ ⲁⲩ̀ⲓ ϣⲁ ⲡⲓϭⲛⲱⲟⲩ ̀ⲛⲧⲉ ⲛⲁⲭⲱⲣ ⲟⲩⲟϩ ⲁϥⲥⲟⲩⲧⲉⲛ ⲧⲉϥϫⲓϫ ̀ⲉⲃⲟⲗ ̀ⲛϫⲉ ⲟⲍⲁ ̀ⲉϯⲕⲓⲃⲱⲧⲟⲥ ̀ⲛⲧⲉ ⲫϯ ̀ⲉⲧⲁϩⲛⲟ ̀ⲙⲙⲟⲥ ⲟⲩⲟϩ ⲁϥⲁⲙⲟⲛⲓ ̀ⲙⲙⲟⲥ ϫⲉ ⲛⲉ ⲁϥϯϭⲗⲁϩ ⲛⲁⲥ ⲡⲉ ̀ⲛϫⲉ ⲡⲓⲙⲁⲥⲓ"
  },
  {
    "chapter": 6,
    "verse": 7,
    "text": "Ⲟⲩⲟϩ ⲁϥⲙⲃⲟⲛ ϧⲉⲛ ⲟⲩϫⲱⲛⲧ ̀ⲛϫⲉ ⲡ⳪̅ ̀ⲉⲟⲍⲁ ⲟⲩⲟϩ ⲁϥⲣⲁϧⲧ ̀ⲙⲙⲟϥ ̀ⲙⲙⲁⲩ ̀ⲛϫⲉ ⲡ⳪̅ ⲟⲩⲟϩ ⲁϥⲙⲟⲩ ̀ⲙⲙⲁⲩ ϧⲁⲧⲉⲛ ϯⲕⲓⲃⲱⲧⲟⲥ ̀ⲛⲧⲉ ⲡ⳪̅ ̀ⲙⲡⲉ̀ⲙⲑⲟ ̀ⲙⲫϯ"
  },
  {
    "chapter": 6,
    "verse": 8,
    "text": "Ⲟⲩⲟϩ ⲁϥⲉⲣⲙⲕⲁϩ ̀ⲛϩⲏⲧ ̀ⲛϫⲉ ⲇⲁⲩⲓⲇ ϫⲉ ϧⲉⲛ ⲟⲩϣⲱⲧ ̀ⲉⲃⲟⲗ ⲁ ⲡ⳪̅ ϥⲱϯ ̀ⲉⲃⲟⲗ ̀ⲛⲟⲍⲁ ⲟⲩⲟϩ ⲁⲩⲙⲟⲩϯ ̀ⲉⲡⲓⲙⲁ ⲉⲧⲉ̀ⲙⲙⲁⲩ ϫⲉ ⲡⲓϥⲱϯ ̀ⲉⲃⲟⲗ ̀ⲛⲧⲉ ⲟⲍⲁ ϣⲁ ̀ⲉϧⲟⲩⲛ ̀ⲉⲫⲟⲟⲩ ̀ⲛⲉϩⲟⲟⲩ ⲫⲁⲓ"
  },
  {
    "chapter": 6,
    "verse": 9,
    "text": "Ⲟⲩⲟϩ ⲁϥⲉⲣϩⲟϯ ̀ⲛϫⲉ ⲇⲁⲩⲓⲇ ϧⲁⲧϩⲏ ̀ⲙⲡ⳪̅ ϧⲉⲛ ⲡⲓⲉϩⲟⲟⲩ ⲉⲧⲉ̀ⲙⲙⲁⲩ ⲉϥϫⲱ ̀ⲙⲙⲟⲥ ϫⲉ ⲡⲱⲥ ϥⲛⲁⲓ ̀ⲉϧⲟⲩⲛ ̀ⲉⲡⲁⲏⲓ ̀ⲛϫⲉ ϯⲕⲓⲃⲱⲧⲟⲥ ̀ⲛⲧⲉ ⲡ⳪̅"
  },
  {
    "chapter": 6,
    "verse": 10,
    "text": "Ⲟⲩⲟϩ ⲛⲁϥⲟⲩⲱϣ ⲁⲛ ⲡⲉ ̀ⲛϫⲉ ⲇⲁⲩⲓⲇ ̀ⲉⲑⲣⲉⲥⲣⲓⲕⲓ ⲛⲁϩⲣⲁϥ ̀ⲛϫⲉ ϯⲕⲓⲃⲱⲧⲟⲥ ̀ⲛⲧⲉ ϯⲇⲓⲁⲑⲏⲕⲏ ̀ⲛⲧⲉ ⲡ⳪̅ ̀ⲉϧⲟⲩⲛ ̀ⲉⲑⲃⲁⲕⲓ ̀ⲛⲧⲉ ⲇⲁⲩⲓⲇ ⲟⲩⲟϩ ⲁϥⲑⲣⲉⲥⲣⲓⲕⲓ ̀ⲛϫⲉ ⲇⲁⲩⲓⲇ ⲉϧⲟⲩⲛ ̀ⲉⲡⲏⲓ ̀ⲛⲁⲃⲉⲇⲇⲁⲣⲁ ⲡⲓⲅⲉⲑⲉⲟⲥ"
  },
  {
    "chapter": 6,
    "verse": 11,
    "text": "Ⲟⲩⲟϩ ⲁⲥϩⲉⲙⲥⲓ ̀ⲛϫⲉ ϯⲕⲓⲃⲱⲧⲟⲥ ̀ⲛⲧⲉ ⲡ⳪̅ ϧⲉⲛ ⲡⲏⲓ ̀ⲛⲁⲃⲉⲇⲇⲁⲣⲁ ⲡⲓⲅⲉⲑⲉⲟⲥ ⲅ̅ ̀ⲛⲁⲃⲟⲧ ⲟⲩⲟϩ ⲁ ⲡ⳪̅ ⲥⲙⲟⲩ ̀ⲉⲡⲏⲓ ̀ⲛⲁⲃⲉⲇⲇⲁⲣⲁ ⲛⲉⲙ ⲛⲏ ⲉⲧⲉ ̀ⲛⲧⲁϥ ⲧⲏⲣⲟⲩ ⲉⲑⲃⲉ ϯⲕⲓⲃⲱⲧⲟⲥ ̀ⲛⲧⲉ ⲡ⳪̅"
  },
  {
    "chapter": 6,
    "verse": 12,
    "text": "Ⲟⲩⲟϩ ⲁⲩⲧⲁⲙⲉ ⲡⲟⲩⲣⲟ ⲉⲩϫⲱ ̀ⲙⲙⲟⲥ ϫⲉ ⲁ ⲡ⳪̅ ̀ⲉⲡⲏⲓ ̀ⲛⲁⲃⲉⲇⲇⲁⲣⲁ ⲛⲉⲙ ⲛⲏ ⲉⲧⲉ̀ⲛⲧⲁϥ ⲧⲏⲣⲟⲩ ⲉⲑⲃⲉ ϯⲕⲓⲃⲱⲧⲟⲥ ̀ⲛⲧⲉ ϯⲇⲓⲁⲑⲏⲕⲏ ̀ⲛⲧⲉ ⲡ⳪̅ ⲟⲩⲟϩ ⲁϥϣⲉ ⲛⲁϥ ̀ⲛϫⲉ ⲇⲁⲩⲓⲇ ⲁϥⲓⲛⲓ ̀ⲉⲡϣⲱⲓ ⲛϯⲕⲓⲃⲱⲧⲟⲥ ̀ⲛⲧⲉ ⲡ⳪̅ ̀ⲉⲃⲟⲗ ϧⲉⲛ ⲡⲏⲓ ̀ⲛⲁⲃⲉⲇⲇⲁⲣⲁ ̀ⲉϧⲟⲩⲛ ̀ⲉⲑⲃⲁⲕⲓ ̀ⲛⲇⲁⲩⲓⲇ ϧⲉⲛ ⲟⲩⲟⲩⲛⲟϥ ⲛⲉⲙ ⲟⲩⲑⲉⲗⲏⲗ"
  },
  {
    "chapter": 6,
    "verse": 13,
    "text": "Ⲟⲩⲟϩ ⲛⲁⲩⲭⲏ ⲛⲉⲙⲱⲟⲩ ⲡⲉ ⲉⲩⲱⲗⲓ ̀ⲛϯⲕⲓⲃⲱⲧⲟⲥ ̀ⲛⲧⲉ ⲡ⳪̅ ̀ⲛϫⲉ ⲍ̅ ̀ⲛⲭⲟⲣⲟⲥ ⲛⲉⲙ ϩⲁⲛϣⲟⲩϣⲱⲟⲩϣⲓ ⲕ̅ ̀ⲙⲙⲁⲥⲓ ⲛⲉⲙ ϩⲁⲛϩⲓⲏⲃ"
  },
  {
    "chapter": 6,
    "verse": 14,
    "text": "Ⲟⲩⲟϩ ⲇⲁⲩⲓⲇ ⲛⲁϥⲕⲱⲗϩ ϧⲉⲛ ϩⲁⲛⲟⲣⲅⲁⲛⲟⲛ ⲉⲩϩⲱⲧⲡ ̀ⲙⲡⲉ̀ⲙⲑⲟ ̀ⲙⲡ⳪̅ ⲟⲩⲟϩ ⲛⲉ ⲟⲩⲟⲛ ⲥⲧⲟⲗⲏ ⲧⲟⲓ ϩⲓⲱⲧϥ ̀ⲛⲇⲁⲩⲓⲇ ⲉⲥⲟⲓ ̀ⲛⲁⲟⲩⲓⲁⲟⲩⲁⲛ"
  },
  {
    "chapter": 6,
    "verse": 15,
    "text": "Ⲟⲩⲟϩ ⲇⲁⲩⲓⲇ ⲛⲉⲙ ⲡⲏⲓ ⲧⲏⲣϥ ̀ⲙⲡⲓⲥ̅ⲗ̅ ⲁⲩⲓⲛⲓ ̀ⲉⲡϣⲱⲓ ̀ⲛϯⲕⲓⲃⲱⲧⲟⲥ ̀ⲛⲧⲉ ⲡ⳪̅ ϧⲉⲛ ⲟⲩϧⲣⲱⲟⲩ ⲛⲉⲙ ⲟⲩⲥⲙⲏ ̀ⲛⲥⲁⲗⲡⲓⲅⲅⲟⲥ"
  },
  {
    "chapter": 6,
    "verse": 16,
    "text": "Ⲟⲩⲟϩ ⲁⲥϣⲱⲡⲓ ⲉⲧⲁⲥ̀ⲓ ̀ⲉⲡϣⲱⲓ ̀ⲛϫⲉ ϯⲕⲓⲃⲱⲧⲟⲥ ̀ⲛⲧⲉ ⲡ⳪̅ ̀ⲉⲑⲃⲁⲕⲓ ̀ⲛⲇⲁⲩⲓⲇ ⲟⲩⲟϩ ⲁ ⲙⲉⲗⲭⲟⲗ ⲧϣⲉⲣⲓ ̀ⲛⲥⲁⲟⲩⲗ ϫⲟⲩϣⲧ ̀ⲉⲃⲟⲗ ϧⲉⲛ ϯϣⲟⲩϣⲧ ⲁⲥⲛⲁⲩ ̀ⲉⲡⲟⲩⲣⲟ ⲇⲁⲩⲓⲇ ⲉϥϭⲟⲥϫⲉⲥ ⲟⲩⲟϩ ⲉϥⲉⲣⲕⲱⲗϩ ̀ⲛϫⲓϫ ̀ⲙⲡⲉ̀ⲙⲑⲟ ̀ⲙⲡ⳪̅ ⲟⲩⲟϩ ⲁⲥϣⲟϣϥϥ ϧⲉⲛ ⲡⲉⲥϩⲏⲧ"
  },
  {
    "chapter": 6,
    "verse": 17,
    "text": "Ⲟⲩⲟϩ ⲁⲩⲓⲛⲓ ̀ⲛϯⲕⲓⲃⲱⲧⲟⲥ ̀ⲛⲧⲉ ⲡ⳪̅ ̀ⲉϧⲟⲩⲛ ⲁⲩⲭⲁⲥ ϧⲉⲛ ⲡⲉⲥⲙⲁ ϧⲉⲛ ϯⲥⲕⲏⲛⲏ ⲑⲏ ⲉⲧⲁϥⲧⲁϫⲣⲟⲥ ⲛⲁⲥ ̀ⲛϫⲉ ⲇⲁⲩⲓⲇ ⲟⲩⲟϩ ⲁ ⲇⲁⲩⲓⲇ ⲓⲛⲓ ̀ⲛϩⲁⲛϭⲗⲓⲗ ̀ⲉϩⲣⲏⲓ ⲛⲉⲙ ϩⲁⲛϩⲓⲣⲏⲛⲏⲕⲟⲛ ̀ⲙⲡⲉ̀ⲙⲑⲟ ̀ⲙⲡ⳪̅"
  },
  {
    "chapter": 6,
    "verse": 18,
    "text": "Ⲟⲩⲟϩ ⲉⲧⲁϥⲟⲩⲱ ̀ⲛϫⲉ ⲇⲁⲩⲓⲇ ⲉϥⲓⲛⲓ ̀ⲉϩⲣⲏⲓ ̀ⲛϩⲁⲛϭⲗⲓⲗ ⲛⲉⲙ ϩⲁⲛϩⲓⲣⲏⲛⲏⲕⲟⲛ ⲁϥⲥⲙⲟⲩ ̀ⲉⲡⲓⲗⲁⲟⲥ ϧⲉⲛ ⲫⲣⲁⲛ ̀ⲙⲡ⳪̅ ̀ⲛⲧⲉ ⲛⲓϫⲟⲙ"
  },
  {
    "chapter": 6,
    "verse": 19,
    "text": "Ⲟⲩⲟϩ ⲁϥⲫⲱϣ ̀ⲙⲡⲓⲗⲁⲟⲥ ⲧⲏⲣϥ ϧⲉⲛ ϯϫⲟⲙ ⲧⲏⲣⲥ ̀ⲛⲧⲉ ⲡⲓⲥ̅ⲗ̅ ⲓⲥϫⲉⲛ ⲇⲁⲛ ϣⲁ ⲃⲏⲣⲥⲁⲃⲉⲉ ⲓⲥϫⲉⲛ ⲟⲩⲣⲱⲙⲓ ϣⲁ ⲟⲩⲥϩⲓⲙⲓ ⲁϥϯ ̀ⲛⲟⲩⲕⲟⲗⲗⲩⲣⲓⲥ ̀ⲛⲱⲓⲕ ̀ⲙⲡⲓⲟⲩⲁⲓ ⲡⲓⲟⲩⲁⲓ ̀ⲙⲙⲱⲟⲩ ⲛⲉⲙ ⲟⲩⲉⲥⲭⲁⲣⲓⲧⲏⲥ ⲛⲉⲙ ⲟⲩϫⲟⲗ ̀ⲛⲗⲁⲕⲉⲛⲧ ⲟⲩⲟϩ ⲁϥϣⲉ ⲛⲁϥ ̀ⲛϫⲉ ⲡⲓⲗⲁⲟⲥ ⲧⲏⲣϥ ⲡⲓⲟⲩⲁⲓ ⲡⲓⲟⲩⲁⲓ ̀ⲉϧⲟⲩⲛ ̀ⲉⲡⲉϥⲏⲓ"
  },
  {
    "chapter": 6,
    "verse": 20,
    "text": "Ⲟⲩⲟϩ ⲁϥⲧⲁⲥⲑⲟ ̀ⲛϫⲉ ⲇⲁⲩⲓⲇ ̀ⲉⲥⲙⲟⲩ ̀ⲉⲡⲉϥⲏⲓ"
  },
