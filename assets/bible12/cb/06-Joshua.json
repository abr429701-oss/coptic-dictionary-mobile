  {
    "chapter": 23,
    "verse": 1,
    "text": "Ⲟⲩⲟϩ ⲓⲏⲥⲟⲩ ⲛⲉ ⲁϥⲉⲣϧⲉⲗⲗⲟ ⲡⲉ ̀ⲉⲁϥϣⲓϣⲓ ϧⲉⲛ ⲛⲉϥⲉϩⲟⲟⲩ"
  },
  {
    "chapter": 23,
    "verse": 2,
    "text": "Ⲟⲩⲟϩ ⲁϥⲙⲟⲩϯ ̀ⲛϫⲉ ⲓⲏⲥⲟⲩⲥ ̀ⲉⲛⲉⲛϣⲏⲣⲓ ̀ⲙⲡⲓⲥ̅ⲗ̅ ⲛⲉⲙ ⲛⲟⲩϧⲉⲗⲗⲟⲓ ⲛⲉⲙ ⲛⲟⲩⲁⲣⲭⲱⲛ ⲛⲉⲙ ⲛⲟⲩⲥⲁϧ ⲛⲉⲙ ⲛⲟⲩⲣⲉϥϯϩⲁⲡ ⲟⲩⲟϩ ⲡⲉϫⲁϥ ⲛⲱⲟⲩ ϫⲉ ̀ⲁⲛⲟⲕ ⲁⲓⲉⲣϧⲉⲗⲗⲟ ⲟⲩⲟϩ ⲁⲓⲁⲓ ϧⲉⲛ ⲛⲁⲉϩⲟⲟⲩ"
  },
  {
    "chapter": 23,
    "verse": 3,
    "text": "̀Ⲛⲑⲱⲧⲉⲛ ⲇⲉ ⲁⲣⲉⲧⲉⲛⲛⲁⲩ ̀ⲉϩⲱⲃ ⲛⲓⲃⲉⲛ ⲉⲧⲁϥⲁⲓⲧⲟⲩ ̀ⲛϫⲉ ⲡ⳪̅ ⲡⲉⲛⲛⲟⲩϯ ̀ⲛⲛⲁⲓⲉⲑⲛⲟⲥ ⲧⲏⲣⲟⲩ ̀ⲉⲃⲟⲗ ϩⲁ ⲡⲉⲧⲉⲛϩⲟ ϫⲉ ⲡ⳪̅ ⲡⲉⲛⲛⲟⲩϯ ⲛⲁϥϯ ̀ⲉϩⲣⲏⲓ ̀ⲉϫⲱⲕ"
  },
  {
    "chapter": 23,
    "verse": 4,
    "text": "Ⲁⲛⲁⲩ ⲓⲥ ϩⲏⲡⲡⲉ ⲁⲓϯ ⲛⲱⲧⲉⲛ ̀ⲛⲛⲓⲉⲑⲛⲟⲥ ⲉⲧⲁⲩⲥⲱϫⲡ ϧⲉⲛ ⲛⲉⲧⲉⲛⲕⲗⲏⲣⲟⲥ ̀ⲉϧⲟⲩⲛ ̀ⲉⲛⲉⲧⲉⲛⲫⲩⲗⲏ ⲓⲥϫⲉⲛ ⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ ⲛⲓⲉⲑⲛⲟⲥ ⲧⲏⲣⲟⲩ ⲁⲓϥⲟⲧⲟⲩ ̀ⲉⲃⲟⲗ ⲟⲩⲟϩ ⲓⲥϫⲉⲛ ⲡⲓⲛⲓϣϯ ̀ⲛⲓⲟⲙ ⲉϥ̀ⲉϣⲱⲡⲓ ⲉϥⲟⲓ ̀ⲛⲑⲱϣ ϣⲁ ⲛⲓⲙⲁ̀ⲛϩⲱⲧⲡ"
  },
  {
    "chapter": 23,
    "verse": 5,
    "text": "Ⲡ⳪̅ ⲇⲉ ⲡⲉⲛⲛⲟⲩϯ ̀ⲛⲑⲟϥ ⲉϥ̀ⲉϥⲟⲧⲟⲩ ̀ⲉⲃⲟⲗ ϧⲁⲧϩⲏ ̀ⲙⲡⲉⲧⲉⲛϩⲟ ϣⲁⲧⲟⲩⲧⲁⲕⲟ ⲉϥ̀ⲉⲟⲩⲱⲣⲡ ⲛⲱⲟⲩ ̀ⲛⲛⲓⲑⲏⲣⲓⲟⲛ ̀ⲛⲁⲅⲣⲓⲟⲛ ϣⲁⲧⲉϥϥⲟⲧⲟⲩ ̀ⲉⲃⲟⲗ ϧⲁ ⲧϩⲏ ̀ⲙⲡⲉⲧⲉⲛϩⲟ ⲟⲩⲟϩ ⲁⲣⲓⲕⲗⲏⲣⲟⲛⲟⲙⲓⲛ ⲡⲕⲁϩⲓ ⲕⲁⲧⲁ ⲫⲣⲏϯ ⲉⲧⲁϥⲥⲁϫⲓ ⲛⲉⲙⲱⲧⲉⲛ ̀ⲛϫⲉ ⲡ⳪̅ ⲡⲉⲛⲛⲟⲩϯ"
  },
  {
    "chapter": 23,
    "verse": 6,
    "text": "Ϫⲉⲙⲛⲟⲙϯ ⲟⲩⲛ ̀ⲉⲙⲁϣⲱ ⲁⲣⲉϩ ̀ⲉⲓⲣⲓ ̀ⲛϩⲱⲃ ⲛⲓⲃⲉⲛ ⲉⲧⲥϧⲏⲧⲟⲩ ϩⲓ ⲡϫⲱⲙ ̀ⲛⲧⲉ ⲫⲛⲟⲙⲟⲥ ̀ⲙⲙⲱ̀ⲩⲥⲏⲥ ϩⲓⲛⲁ ̀ⲛⲧⲉⲧⲉⲛ̀ϣⲧⲉⲙⲣⲓⲕⲓ ̀ⲉⲟⲩⲓⲛⲁⲙ ⲟⲩⲇⲉ ϫⲁϭⲏ"
  },
  {
    "chapter": 23,
    "verse": 7,
    "text": "Ϩⲟⲡⲱⲥ ̀ⲛⲧⲉⲧⲉⲛ̀ϣⲧⲉⲙϣⲉ ̀ⲉϧⲟⲩⲛ ̀ⲉⲛⲁⲓⲉⲑⲛⲟⲥ ⲉⲧⲁⲩⲥⲱϫⲡ ⲟⲩⲟϩ ⲫⲣⲁⲛ ̀ⲛⲛⲟⲩⲛⲟⲩϯ ̀ⲛⲛⲟⲩϫⲟϥ ϧⲉⲛ ⲑⲏⲛⲟⲩ ⲟⲩⲇⲉ ̀ⲛⲛⲉⲧⲉⲛⲟⲩⲱϣⲧ ̀ⲙⲙⲱⲟⲩ ⲟⲩⲇⲉ ̀ⲛⲛⲉⲧⲉⲛϣⲉⲙϣⲓ ̀ⲙⲙⲱⲟⲩ"
  },
  {
    "chapter": 23,
    "verse": 8,
    "text": "Ⲁⲗⲗⲁ ⲉⲣⲉⲧⲉⲛⲉⲧⲉⲙ ⲑⲏⲛⲟⲩ ̀ⲉⲡ⳪̅ ⲡⲉⲛⲛⲟⲩϯ ⲕⲁⲧⲁ ⲫⲣⲏϯ ⲉⲧⲁⲣⲉⲧⲉⲛⲁⲓⲥ ϣⲁ ̀ⲉϧⲟⲩⲛ ̀ⲉⲡⲁⲓⲉϩⲟⲟⲩ"
  },
  {
    "chapter": 23,
    "verse": 9,
    "text": "Ⲟⲩⲟϩ ⲉϥ̀ⲉϥⲟⲧⲟⲩ ̀ⲉⲃⲟⲗ ̀ⲛϫⲉ ⲡ⳪̅ ̀ⲉⲃⲟⲗ ϩⲁ ⲡⲉⲧⲉⲛϩⲟ ϩⲁⲛⲛⲓϣϯ ̀ⲛⲉⲑⲛⲟⲥ ⲟⲩⲟϩ ⲉⲩϫⲟⲣ ⲟⲩⲟϩ ̀ⲙⲡⲉ ϩⲗⲓ ⲟϩⲓ ̀ⲉⲣⲁⲧϥ ̀ⲙⲡⲉⲧⲉⲛ̀ⲙⲑⲟ ϣⲁ ̀ⲉϧⲟⲩⲛ ̀ⲉⲡⲁⲓⲉϩⲟⲟⲩ"
  },
  {
    "chapter": 23,
    "verse": 10,
    "text": "Ⲟⲩⲁⲓ ̀ⲉⲃⲟⲗ ϧⲉⲛ ⲑⲏⲛⲟⲩ ⲁϥϭⲟϫⲓ ̀ⲛⲥⲁ ⲟⲩϣⲟ ϫⲉ ⲡ⳪̅ ⲡⲉⲛⲛⲟⲩϯ ⲛⲁϥϯ ̀ⲉϩⲣⲏⲓ ̀ⲉϫⲱⲛ ⲕⲁⲧⲁ ⲫⲣⲏϯ ⲉⲧⲁϥϫⲟⲥ ⲛⲁⲛ"
  },
  {
    "chapter": 23,
    "verse": 11,
    "text": "Ⲟⲩⲟϩ ⲉⲣⲉⲧⲉⲛ̀ⲉⲁⲣⲉϩ ̀ⲉⲙⲁϣⲱ ̀ⲉⲙⲉⲛⲣⲉ ⲡ⳪̅ ⲡⲉⲛⲛⲟⲩϯ"
  },
  {
    "chapter": 23,
    "verse": 12,
    "text": "̀Ⲉϣⲱⲡ ⲅⲁⲣ ̀ⲛⲧⲉⲧⲉⲛⲫⲉⲛϩ ⲑⲏⲛⲟⲩ ̀ⲛⲧⲉⲧⲉⲛⲙⲟⲩϫⲧ ⲛⲉⲙ ⲛⲓⲉⲑⲛⲟⲥ ⲁⲩⲥⲱϫⲡ ⲛⲉⲙⲱⲧⲉⲛ ⲟⲩⲟϩ ̀ⲛⲧⲉⲧⲉⲛϣⲟⲙ ̀ⲉⲣⲱⲟⲩ ̀ⲛⲧⲉⲧⲉⲛⲙⲟⲩϫⲧ ̀ⲛϧⲏⲧⲟⲩ ⲟⲩⲟϩ ̀ⲛⲑⲱⲟⲩ ϧⲉⲛ ⲑⲏⲛⲟⲩ"
  },
  {
    "chapter": 23,
    "verse": 13,
    "text": "Ⲁⲣⲓⲉⲙⲓ ϫⲉ ̀ⲛⲛⲉϥⲟⲩⲁϩ ⲧⲟⲧϥ ̀ⲛϫⲉ ⲡ⳪̅ ⲉϥⲱϯ ̀ⲛⲛⲁⲓⲉⲑⲛⲟⲥ ̀ⲉⲃⲟⲗ ϧⲁⲧϩⲏ ̀ⲙⲡⲉⲧⲉⲛϩⲟ ⲟⲩⲟϩ ⲉⲩ̀ⲉϣⲱⲡⲓ ⲛⲱⲧⲉⲛ ⲉⲩⲫⲁϣ ⲛⲉⲙ ⲟⲩⲥⲕⲁⲛⲇⲁⲗⲟⲛ ⲛⲉⲙ ϩⲁⲛⲓϥⲧ ϧⲉⲛ ⲛⲉⲧⲉⲛⲑⲓⲃⲥ ⲛⲉⲙ ϩⲁⲛⲥⲟⲩⲣⲓ ϧⲉⲛ ⲛⲉⲧⲉⲛⲃⲁⲗ ϣⲁⲛⲧⲉⲧⲉⲛⲧⲁⲕⲟ ̀ⲉⲃⲟⲗ ϩⲁ ⲡⲓⲕⲁϩⲓ ̀ⲛⲁⲅⲁⲑⲟⲛ ⲫⲏ ⲉⲧⲁϥⲧⲏⲓϥ ⲛⲱⲧⲉⲛ ̀ⲛϫⲉ ⲡ⳪̅ ⲡⲉⲛⲛⲟⲩϯ"
  },
  {
    "chapter": 23,
    "verse": 14,
    "text": "̀Ⲁⲛⲟⲕ ⲇⲉ ϯⲛⲁϣⲉ ⲛⲏⲓ ϩⲓ ⲡⲓⲙⲱⲓⲧ ⲕⲁⲧⲁ ⲫⲣⲏϯ ̀ⲛⲛⲏ ⲧⲏⲣⲟⲩ ⲉⲧϩⲓϫⲉⲛ ⲡⲓⲕⲁϩⲓ ⲟⲩⲟϩ ⲉⲣⲉⲧⲉⲛ̀ⲉⲉⲙⲓ ϧⲉⲛ ⲡⲉⲧⲉⲛϩⲏⲧ ⲛⲉⲙ ⲧⲉⲧⲉⲛⲯⲩⲭⲏ ϫⲉ ̀ⲙⲡⲉ ⲟⲩⲥⲁϫⲓ ̀ⲛⲟⲩⲱⲧ ϩⲉⲓ ̀ⲉⲃⲟⲗ ϧⲉⲛ ⲛⲓⲥⲁϫⲓ ⲧⲏⲣⲟⲩ ⲉⲧⲁϥϫⲟⲧⲟⲩ ⲛⲁⲛ ̀ⲛϫⲉ ⲡ⳪̅ ⲡⲉⲛⲛⲟⲩϯ ⲕⲁⲧⲁ ϩⲱⲃ ⲛⲓⲃⲉⲛ ⲉⲧⲉⲣⲛⲟϥⲣⲓ ⲛⲁⲛ ⲁⲩϣⲱⲡⲓ ⲧⲏⲣⲟⲩ"
  },
  {
    "chapter": 23,
