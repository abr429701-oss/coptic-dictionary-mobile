  {
    "chapter": 3,
    "verse": 7,
    "text": "Ⲟⲩⲟϩ ⲡⲉϫⲉ ⲡ⳪̅ ̀ⲛⲓⲏⲥⲟⲩ ϫⲉ ϧⲉⲛ ⲫⲟⲟⲩ ̀ⲛⲉϩⲟⲟⲩ ϯⲛⲁⲉⲣϩⲏⲧⲥ ̀ⲛϭⲓⲥⲓ ̀ⲙⲙⲟⲕ ̀ⲙⲡⲉ̀ⲙⲑⲟ ̀ⲛⲛⲉⲛϣⲏⲣⲓ ̀ⲙⲡⲓⲥ̅ⲗ̅ ⲧⲏⲣⲟⲩ ϫⲉ ϩⲓⲛⲁ ⲉⲩ̀ⲉⲉⲙⲓ ϫⲉ ⲕⲁⲧⲁ ⲫⲣⲏϯ ⲉⲧⲁⲓϣⲱⲡⲓ ⲛⲉⲙ ⲙⲱ̀ⲩⲥⲏⲥ ⲡⲁⲓⲣⲏϯ ϯⲛⲁϣⲱⲡⲓ ⲛⲉⲙⲁⲕ ϩⲱⲕ"
  },
  {
    "chapter": 3,
    "verse": 8,
    "text": "Ⲟⲩⲟϩ ϯⲛⲟⲩ ϩⲟⲛϩⲉⲛ ̀ⲛⲛⲓⲟⲩⲏⲃ ⲉⲑⲃⲉ ϯⲕⲩⲃⲱⲧⲟⲥ ̀ⲛⲧⲉ ϯⲇⲓⲁⲑⲏⲕⲏ ⲉⲕϫⲱ ̀ⲙⲙⲟⲥ ⲛⲱⲟⲩ ϫⲉ ⲁⲣⲉⲧⲉⲛϣⲁⲛϣⲉ ⲛⲱⲧⲉⲛ ̀ⲉϧⲟⲩⲛ ̀ⲉⲡⲓⲙⲱⲟⲩ ̀ⲛⲧⲉ ⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ ⲧⲉⲧⲉⲛⲟϩⲓ ̀ⲉⲣⲁⲧⲉⲛ ⲑⲏⲛⲟⲩ ϧⲉⲛ ⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ"
  },
  {
    "chapter": 3,
    "verse": 9,
    "text": "Ⲟⲩⲟϩ ⲡⲉϫⲉ ⲓⲏⲥⲟⲩ ̀ⲛⲛⲉⲛϣⲏⲣⲓ ̀ⲙⲡⲓⲥ̅ⲗ̅ ϫⲉ ϯ ̀ⲙⲡⲉⲧⲉⲛⲟⲩⲟⲓ ̀ⲙⲡⲁⲓⲙⲁ ̀ⲉϧⲟⲩⲛ ̀ⲉⲣⲟⲓ ̀ⲛⲧⲉⲧⲉⲛⲥⲱⲧⲉⲙ ̀ⲙⲡⲥⲁϫⲓ ̀ⲙⲡ⳪̅ ⲫϯ"
  },
  {
    "chapter": 3,
    "verse": 10,
    "text": "Ϧⲉⲛ ⲫⲁⲓ ⲧⲉⲧⲉⲛⲛⲁⲉⲙⲓ ϫⲉ ⲫϯ ⲉⲧⲟⲛϧ ⲛⲉⲙⲱⲧⲉⲛ ⲟⲩⲟϩ ϧⲉⲛ ⲟⲩϥⲱϯ ̀ⲉⲃⲟⲗ ϥⲛⲁϥⲱϯ ̀ⲉⲃⲟⲗ ϧⲁ ⲧⲉⲧⲉⲛϩⲏ ̀ⲙⲡⲓⲭⲁⲛⲁⲛⲉⲟⲥ ⲛⲉⲙ ⲭⲉⲧⲧⲉⲟⲥ ⲛⲉⲙ ⲫⲉⲣⲉⲍⲉⲟⲥ ⲛⲉⲙ ⲉⲩⲉⲟⲥ ⲛⲉⲙ ⲁⲙⲟⲣⲣⲉⲟⲥ ⲛⲉⲙ ⲅⲉⲣⲅⲉⲥⲉⲟⲥ ⲛⲉⲙ ⲓⲉⲃⲟⲩⲥⲉⲟⲥ"
  },
  {
    "chapter": 3,
    "verse": 11,
    "text": "Ϩⲏⲡⲡⲉ ⲓⲥ ̀ⲛϫⲉ ϯⲕⲓⲃⲱⲧⲟⲥ ̀ⲛⲧⲉ ϯⲇⲓⲁⲑⲏⲕⲏ ̀ⲙⲡ⳪̅ ̀ⲙⲡⲕⲁϩⲓ ⲧⲏⲣϥ ⲥⲉⲛⲁⲉⲣϫⲓⲛⲓⲟⲣ ̀ⲙⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ ϩⲓ ⲧϩⲏ ̀ⲙⲙⲱⲧⲉⲛ"
  },
  {
    "chapter": 3,
    "verse": 12,
    "text": "Ϯⲛⲟⲩ ⲇⲉ ϭⲓ ̀ⲉⲃⲟⲗ ϧⲉⲛ ⲑⲏⲛⲟⲩ ̀ⲙⲓ̅ⲃ̅ ̀ⲛⲣⲱⲙⲓ ̀ⲉⲃⲟⲗ ϧⲉⲛ ⲛⲉⲛϣⲏⲣⲓ ̀ⲙⲡⲓⲥ̅ⲗ̅ ⲟⲩⲣⲱⲙⲓ ⲕⲁⲧⲁ ⲫⲩⲗⲏ"
  },
  {
    "chapter": 3,
    "verse": 13,
    "text": "Ⲟⲩⲟϩ ⲉⲣⲉ ⲛⲓⲟⲩⲏⲃ ⲟϩⲓ ̀ⲉⲣⲁⲧⲟⲩ ⲛⲏ ⲉⲧϥⲁⲓ ϧⲁ ϯⲕⲓⲃⲱⲧⲟⲥ ̀ⲛⲧⲉ ϯⲇⲓⲁⲑⲏⲕⲏ ̀ⲙⲡ⳪̅ ̀ⲙⲡⲕⲁϩⲓ ⲧⲏⲣϥ ϧⲉⲛ ⲫⲙⲱⲟⲩ ̀ⲛⲧⲉ ⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ ⲛⲁⲩⲱϣⲉⲙ ⲇⲉ ⲉⲧϣⲟⲩⲱ ̀ⲉϩⲣⲏⲓ ̀ⲛⲁⲕⲛⲏ ⲉϥϣⲟⲩⲱ ̀ⲉϧⲣⲏⲓ"
  },
  {
    "chapter": 3,
    "verse": 14,
    "text": "Ⲟⲩⲟϩ ⲡⲓⲗⲁⲟⲥ ⲁϥⲧⲱⲛϥ ϧⲉⲛ ⲛⲟⲩⲙⲁ̀ⲛϣⲱⲡⲓ ̀ⲉⲑⲣⲟⲩⲉⲣϫⲓⲛⲓⲟⲣ ⲙⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ ⲛⲓⲟⲩⲏⲃ ⲇⲉ ⲁⲩⲧⲁⲗⲟ ̀ⲉϫⲱⲟⲩ ̀ⲛϯⲕⲓⲃⲱⲧⲟⲥ ̀ⲛϯⲇⲓⲁⲑⲏⲕⲏ ̀ⲙⲡ⳪̅ ϩⲓ ⲧϩⲏ ̀ⲙⲙⲱⲟⲩ"
  },
  {
    "chapter": 3,
    "verse": 15,
    "text": "Ϧⲉⲛ ⲡϫⲓⲛⲑⲣⲟⲩⲓⲛⲓ ⲇⲉ ̀ⲉϧⲟⲩⲛ ̀ⲛϯⲕⲓⲃⲱⲧⲟⲥ ̀ⲉⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ ̀ⲛϫⲉ ⲛⲓⲟⲩⲏⲃ ⲉⲩϥⲁⲓ ϧⲁ ϯⲕⲩⲃⲱⲧⲟⲥ ̀ⲛⲧⲉ ϯⲇⲓⲁⲑⲏⲕⲏ ̀ⲙⲡ⳪̅ ⲁⲩϫⲟⲗⲕⲟⲩ ⲁⲩⲱⲙⲥ ̀ⲛⲟⲩⲙⲉⲣⲟⲥ ϧⲉⲛ ⲫⲙⲱⲟⲩ ̀ⲙⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ ⲛⲁϥⲙⲉϩ ⲇⲉ ̀ⲙⲙⲱⲟⲩ ϣⲁ ⲛⲉϥⲥⲫⲟⲧⲟⲩ ̀ⲙⲫⲣⲏϯ ̀ⲛⲛⲓⲉϩⲟⲟⲩ ̀ⲛⲧⲉ ⲡⲓⲱⲥϧ ̀ⲛⲥⲟⲩⲟ"
  },
  {
    "chapter": 3,
    "verse": 16,
    "text": "Ⲟⲩⲟϩ ⲉⲧⲁⲩϭⲣⲟ ̀ⲉⲙⲁϣⲱ ϣⲁ ̀ⲉϩⲣⲏⲓ ̀ⲉⲡⲥⲁ ̀ⲛⲕⲁⲣⲓⲁⲑⲓⲁⲣⲓⲙ ̀ⲙⲫⲙⲱⲟⲩ ⲉⲧϣⲟⲩⲱ ̀ⲉϩⲣⲏⲓ ⲁϥϧⲁϯ ̀ⲉⲃⲟⲗ ̀ⲉⲫⲓⲟⲙ ̀ⲛⲛⲓϩⲙⲟⲩ ϣⲁⲛⲧⲉϥⲙⲟⲩⲛⲕ ̀ⲉⲡⲧⲏⲣϥ ⲟⲩⲟϩ ⲡⲓⲗⲁⲟⲥ ⲛⲁϥⲟϩⲓ ̀ⲉⲣⲁⲧϥ ̀ⲙⲡⲉ̀ⲙⲑⲟ ̀ⲛⲓⲉⲣⲓⲭⲱ"
  },
  {
    "chapter": 3,
    "verse": 17,
    "text": "Ⲟⲩⲟϩ ⲛⲓⲟⲩⲏⲃ ⲉⲧϥⲁⲓ ϧⲁ ϯⲕⲓⲃⲱⲧⲟⲥ ̀ⲛϯⲇⲓⲁⲑⲏⲕⲏ ̀ⲙⲡ⳪̅ ⲟϩⲓ ̀ⲉⲣⲁⲧⲟⲩ ϩⲓϫⲉⲛ ⲛⲏ ⲉⲧϣⲟⲩⲱ ϧⲉⲛ ⲑⲙⲏϯ ̀ⲙⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ ⲟⲩⲟϩ ⲛⲉⲛϣⲏⲣⲓ ̀ⲙⲡⲓⲥ̅ⲗ̅ ̀ⲉϫⲉⲛ ⲓⲟⲣ ⲁⲩⲙⲟϣⲓ ϧⲉⲛ ⲡⲉⲧϣⲟⲩⲱ ϣⲁⲛⲧⲉ ⲡⲓⲗⲁⲟⲥ ⲉⲣϫⲓⲛⲓⲟⲣ ̀ⲙⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ"
  },
  {
    "chapter": 4,
    "verse": 1,
    "text": "Ⲡ⳪̅ ⲇⲉ ⲁϥⲥⲁϫⲓ ⲛⲉⲙ ⲓⲏⲥⲟⲩ ⲉϥϫⲱ ̀ⲙⲙⲟⲥ ⲙⲉⲛⲉⲛⲥⲁ ⲑⲣⲉ ⲡⲓⲗⲁⲟⲥ ⲧⲏⲣϥ ⲉϥϫⲓⲛⲓⲟⲣ ̀ⲙⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ"
  },
  {
    "chapter": 4,
    "verse": 2,
    "text": "Ϫⲉ ϭⲓ ̀ⲛϩⲁⲛⲣⲱⲙⲓ ̀ⲉⲃⲟⲗ ϧⲉⲛ ⲡⲓⲗⲁⲟⲥ ⲟⲩⲣⲱⲙⲓ ⲕⲁⲧⲁ ⲫⲩⲗⲏ"
  },
  {
    "chapter": 4,
    "verse": 3,
    "text": "̀Ⲛⲧⲉⲕϩⲟⲛϩⲉⲛ ̀ⲛⲧⲟⲧⲟⲩ ̀ⲛⲥⲉⲱⲗⲓ ̀ⲉⲃⲟⲗ ϧⲉⲛ ⲡⲓⲙⲁ ϧⲉⲛ ⲑⲙⲏϯ ̀ⲙⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ ̀ⲙⲡⲓⲓ̅ⲃ̅ ̀ⲛⲱⲛⲓ ⲉⲩⲟⲩⲟϫ ⲟⲩⲟϩ ⲛⲁⲓ ⲙⲁⲣⲟⲩⲭⲁⲩ ̀ⲛϧⲣⲏⲓ ϩⲓ ⲟⲩⲥⲟⲡ ϧⲉⲛ ⲛⲉⲧⲉⲛⲙⲁ̀ⲛϣⲱⲡⲓ ̀ⲙⲡⲕⲱϯ"
  },
  {
    "chapter": 4,
    "verse": 4,
    "text": "Ⲟⲩⲟϩ ϧⲉⲛ ⲡϫⲓⲛⲑⲣⲉ ⲓⲏⲥⲟⲩ ⲙⲟⲩϯ ̀ⲙⲡⲓⲓⲃ ̀ⲛⲣⲱⲙⲓ ̀ⲉⲃⲟⲗ ϧⲉⲛ ⲛⲏ ⲉⲧⲟⲓ ̀ⲛⲛⲉⲛϣⲏⲣⲓ ̀ⲙⲡⲓⲥ̅ⲗ̅ ⲟⲩⲣⲱⲙⲓ ⲕⲁⲧⲁ ⲫⲩⲗⲏ"
  },
  {
    "chapter": 4,
    "verse": 5,
    "text": "Ⲁϥⲥⲁϫⲓ ⲛⲉⲙⲱⲟⲩ ⲉϥϫⲱ ̀ⲙⲙⲟⲥ ϫⲉ ϯ ̀ⲙⲡⲉⲧⲉⲛⲟⲩⲟⲓ ϩⲓⲧϩⲏ ̀ⲙⲙⲟⲓ ̀ⲙⲡⲉ̀ⲙⲑⲟ ̀ⲉⲃⲟⲗ ̀ⲙⲡ⳪̅ ϧⲉⲛ ⲑⲙⲏϯ ̀ⲙⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ ⲟⲩⲟϩ ⲙⲁⲣⲉ ⲡⲓⲟⲩⲁⲓ ̀ⲙⲙⲱⲧⲉⲛ ϭⲓ ̀ⲉⲃⲟⲗ ϧⲉⲛ ⲡⲓⲙⲁ ⲉⲧⲉ̀ⲙⲙⲁⲩ ̀ⲛⲟⲩⲱⲛⲓ ̀ⲛⲧⲉϥⲧⲁⲗⲟϥ ̀ⲉϫⲉⲛ ⲧⲉϥⲛⲁϩⲃⲓ ⲕⲁⲧⲁ ⲧⲓ̅ⲃ̅ ̀ⲙⲫⲩⲗⲏ ̀ⲛⲧⲉ ⲡⲓⲥ̅ⲗ̅"
  },
  {
    "chapter": 4,
    "verse": 6,
    "text": "Ϫⲉ ϩⲓⲛⲁ ̀ⲛⲧⲉ ⲛⲁⲓ ϣⲱⲡⲓ ⲛⲱⲧⲉⲛ ⲉⲩⲙⲏⲓⲛⲓ ⲉϥⲭⲏ ̀ⲉϧⲣⲏⲓ ̀ⲛⲥⲏⲟⲩ ⲛⲓⲃⲉⲛ ϫⲉ ϩⲓⲛⲁ ⲁϥϣⲁⲛϣⲉⲛⲕ ̀ⲛⲣⲁⲥϯ ̀ⲛϫⲉ ⲡⲉⲕϣⲏⲣⲓ ⲉϥϫⲱ ̀ⲙⲙⲟⲥ ϫⲉ ⲟⲩ ⲛⲉ ⲛⲁⲓⲱⲛⲓ ⲉⲧⲭⲏ ̀ⲉϧⲣⲏⲓ ⲛⲱⲧⲉⲛ"
  },
  {
    "chapter": 4,
    "verse": 7,
    "text": "̀Ⲛⲑⲟⲕ ϩⲱⲕ ⲉⲕ̀ⲉⲉⲣⲟⲩⲱ ̀ⲙⲡⲉⲕϣⲏⲣⲓ ⲉⲕϫⲱ ̀ⲙⲙⲟⲥ ⲛⲁϥ ϫⲉ ⲉⲑⲃⲉ ϫⲉ ⲁϥⲙⲟⲩⲛⲕ ̀ⲛϫⲉ ⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ ⲛⲓⲁⲣⲟ ϧⲁⲧϩⲏ ̀ⲛϯⲕⲩⲃⲱⲧⲟⲥ ̀ⲛϯⲇⲓⲁⲑⲏⲕⲏ ̀ⲙⲡ⳪̅ ̀ⲙⲡⲕⲁϩⲓ ⲧⲏⲣϥ ̀ⲉⲑⲣⲉⲥϫⲓⲛⲓⲟⲣ ̀ⲙⲙⲟϥ ⲟⲩⲟϩ ⲛⲁⲓⲱⲛⲓ ⲉⲩ̀ⲉϣⲱⲡⲓ ⲛⲱⲧⲉⲛ ̀ⲛⲟⲩⲉⲣⲫⲙⲉⲩⲓ ϧⲉⲛ ⲛⲉⲛϣⲏⲣⲓ ̀ⲙⲡⲓⲥ̅ⲗ̅ ϣⲁ ⲉⲛⲉϩ"
  },
  {
    "chapter": 4,
    "verse": 8,
    "text": "Ⲟⲩⲟϩ ⲁⲩⲓⲣⲓ ⲛ̀ϫⲉ ⲛⲉⲛϣⲏⲣⲓ ̀ⲙⲡⲓⲥ̅ⲗ̅ ⲕⲁⲧⲁ ⲫⲣⲏϯ ⲉⲧⲁϥϩⲟⲛϩⲉⲛ ̀ⲛⲧⲟⲧϥ ̀ⲛⲓⲏⲥⲟⲩ ⲟⲩⲟϩ ϧⲉⲛ ⲡϫⲓⲛⲑⲣⲟⲩⲱⲗⲓ ̀ⲙⲡⲓ̅ⲃ̅ ̀ⲛⲱⲛⲓ ̀ⲉⲃⲟⲗ ϧⲉⲛ ⲑⲙⲏϯ ⲙⲡⲓⲓⲟⲣⲇⲁⲛⲏⲥ ⲕⲁⲧⲁ ⲫⲣⲏϯ ⲉⲧⲁ ⲡ⳪̅ ϩⲟⲛϩⲉⲛ ̀ⲉⲧⲟⲧϥ ̀ⲛⲓⲏⲥⲟⲩ ϧⲉⲛ ⲡϫⲓⲛⲑⲣⲟⲩⲕⲏⲛ ⲇⲉ ⲉⲩⲉⲣϫⲓⲛⲓⲟⲣ ⲧⲏⲣⲟⲩ ̀ⲛϫⲉ ⲛⲉⲛϣⲏⲣⲓ ̀ⲙⲡⲓⲥ̅ⲗ̅ ⲉⲩⲱⲗⲓ ̀ⲙⲙⲱⲟⲩ ⲛⲉⲙⲱⲟⲩ ̀ⲉϩⲣⲏⲓ ⲉⲧⲟⲩⲡⲁⲣⲉⲙⲃⲟⲗⲏ ⲁⲩⲭⲁⲩ ϧⲉⲛ ⲡⲓⲙⲁ ⲉⲧⲉ̀ⲙⲙⲁⲩ"
  },
  {
    "chapter": 4,
    "verse": 9,
    "text": "Ⲓⲏⲥⲟⲩ ⲇⲉ ⲁϥⲧⲁϩⲟ ̀ⲉⲣⲁⲧⲟⲩ ̀ⲛⲕⲉⲓ̅ⲃ̅ ̀ⲛⲱⲛⲓ ϧⲉⲛ ⲡⲓⲙⲁ ⲉⲧⲟⲩⲙⲟⲩϯ ̀ⲉⲣⲟϥ ϫⲉ ⲭⲁⲧⲟⲩ ̀ⲛⲛⲓϭⲁⲗⲁⲩϫ ̀ⲛⲛⲓⲟⲩⲏⲛ ⲛⲏ ⲉⲧϥⲁⲓ ϧⲁ ϯⲕⲩⲃⲱⲧⲟⲥ ̀ⲛϯⲇⲓⲁⲑⲏⲕⲏ ̀ⲙⲡ⳪̅ ⲟⲩⲟϩ ⲥⲉⲭⲏ ̀ⲉϧⲣⲏⲓ ϧⲉⲛ ⲡⲓⲙⲁ ⲉⲧⲉ̀ⲙⲙⲁⲩ ϣⲁ ̀ⲉϧⲣⲏⲓ ̀ⲉⲫⲟⲟⲩ ̀ⲛⲉϩⲟⲟⲩ"
  },
